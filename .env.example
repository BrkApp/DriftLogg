# GitHub Personal Access Token (optionnel)
# Sans token : 60 requêtes/h (unauthenticated rate limit GitHub)
# Avec token  : 5 000 requêtes/h — fortement recommandé en production
#
# Créer un token : https://github.com/settings/tokens
# Permissions requises : aucune (lecture publique uniquement)
GITHUB_TOKEN=

# Vercel KV (optionnel — production)
# Si défini, le cache des scans utilise Vercel KV au lieu de la mémoire.
# Sans ces variables, le cache reste en mémoire (TTL 10 min, max 500 entrées).
# Doc : https://vercel.com/docs/storage/vercel-kv
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Clé d'admin pour /api/cache/stats (obligatoire pour activer l'endpoint)
# Header de la requête : X-Admin-Key: <valeur>
# Sans cette variable, l'endpoint retourne 503.
ADMIN_KEY=
